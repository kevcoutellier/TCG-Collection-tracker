# Copier ce fichier en .env.local puis renseigner les valeurs souhaitées. Tout est optionnel.

# Ventes réelles des cartes gradées (PSA, CGC, BGS, SGC) issues d'eBay.
# Clé gratuite sur https://www.pokemonpricetracker.com (100 crédits/jour, 2 crédits par carte).
# Sans clé, l'app affiche une estimation à partir de la cote brute.
POKEMONPRICETRACKER_API_KEY=

# Scanner photo : identification des cartes par l'IA Claude (plusieurs cartes par photo, cartes gradées).
# Clé sur https://console.anthropic.com. Sans clé, le scanner lit le numéro des cartes par OCR dans le navigateur.
# Chaque photo analysée est facturée par Anthropic : ne déployez pas l'app publiquement avec cette clé.
ANTHROPIC_API_KEY=
# Modèle utilisé pour la vision (par défaut claude-opus-5-5).
CLAUDE_VISION_MODEL=

# Opportunités : annonces eBay en direct (API Browse officielle, eBay France), port compris.
# Clés « Production » gratuites sur https://developer.ebay.com. Sans clés, l'app propose une recherche eBay préremplie.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Base Postgres pour un déploiement (Neon, Supabase…). Vide = base locale PGlite dans .data/.
DATABASE_URL=

# Protège la route /api/cron/snapshot (relevé quotidien des prix) en production.
CRON_SECRET=
