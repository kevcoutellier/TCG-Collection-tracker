# Copier ce fichier en .env.local puis renseigner les valeurs souhaitées. Tout est optionnel.

# Ventes réelles des cartes gradées (PSA, CGC, BGS, SGC) issues d'eBay.
# Clé gratuite sur https://www.pokemonpricetracker.com (100 crédits/jour, 2 crédits par carte).
# Sans clé, l'app affiche une estimation à partir de la cote brute.
POKEMONPRICETRACKER_API_KEY=

# Prix du marché français des produits scellés : annonces en cours sur eBay.fr (neuf, vendeurs en France).
# Compte développeur gratuit sur https://developer.ebay.com → Application Keys → jeu « Production »
# (App ID = client id, Cert ID = client secret). Sans clés, les scellés sont cotés sur Cardmarket (toutes langues).
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Base Postgres pour un déploiement (Neon, Supabase…). Vide = base locale PGlite dans .data/.
DATABASE_URL=

# Protège les routes du cron en production : /api/cron/catalog (copie du catalogue TCGdex) et
# /api/cron/snapshot (relevé quotidien des prix). Vercel Cron l'envoie tout seul. Vide = routes publiques,
# limitées à un passage par heure chacune.
CRON_SECRET=

# Code d'invitation demandé à la création d'un compte : partagez-le avec vos amis en même temps que l'URL.
# Vide = inscription ouverte à toute personne qui connaît l'URL.
INVITE_CODE=
